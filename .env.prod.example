# Copy to .env.prod. Never commit real credentials.
POSTGRES_DB=gestaodireta
POSTGRES_USER=gestaodireta
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD

APP_JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
APP_COOKIE_SECURE=true
APP_COOKIE_SAME_SITE=Lax
APP_CORS_ALLOWED_ORIGINS=https://gestaodireta.brenocarvalhodev.io

# Hosted Gemini integration: no Ollama or Whisper containers in production.
APP_AI_PROVIDER=gemini
APP_AI_GEMINI_API_KEY=
APP_TRANSCRIPTION_PROVIDER=gemini
APP_AI_AUDIO_TRANSCRIPTION_ENABLED=false
AI_FINANCIAL_EXTRACTION_ENABLED=false
AI_HEALTH_CHECK_ENABLED=false

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
